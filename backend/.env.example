# CrownLuxe Wigs Backend Environment Configuration
SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL Production:
# DATABASE_URL=postgresql://crownluxe_user:securepassword@localhost:5432/crownluxe_db
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
DEFAULT_CURRENCY=UGX
FRONTEND_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
REDIS_URL=redis://127.0.0.1:6379/1
CART_CACHE_TTL=604800
SESSION_COOKIE_AGE=2592000
SESSION_COOKIE_SAMESITE=Lax
# Production only: use HTTPS, DEBUG=False, and a secure Redis URL (rediss://...)
